#!/sbin/openrc-run
description="Audio Module USB-C gadget (Windows NCM network plus ACM console)"

depend() {
    need sysfs
    before networking
}

start() {
    ebegin "Starting Audio Module USB gadget"
    local g="/sys/kernel/config/usb_gadget/audio_module"
    local controller
    [ -d /sys/kernel/config/usb_gadget ] || { eend 1; return 1; }
    controller="$(ls /sys/class/udc 2>/dev/null | head -n 1)"
    [ -n "$controller" ] || { eend 1; return 1; }
    mkdir -p "$g" "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
    cd "$g" || { eend 1; return 1; }
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0200 > bcdUSB
    echo 0x0200 > bcdDevice
    echo 0xef > bDeviceClass
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol
    echo "Koba Audio Module" > strings/0x409/manufacturer
    echo "Capsula Mini" > strings/0x409/product
    # A unique serial per device must be provisioned before multi-device rollout.
    echo "capsula-mini-unprovisioned" > strings/0x409/serialnumber
    echo "NCM + USB serial" > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower
    if [ ! -d functions/ncm.usb0 ]; then
        mkdir functions/ncm.usb0
        echo "02:1a:11:00:00:01" > functions/ncm.usb0/dev_addr
        echo "02:1a:11:00:00:02" > functions/ncm.usb0/host_addr
    fi
    mkdir -p functions/acm.gs0
    echo WINNCM > functions/ncm.usb0/os_desc/interface.ncm/compatible_id
    echo 1 > os_desc/use
    echo 0xcd > os_desc/b_vendor_code
    echo MSFT100 > os_desc/qw_sign
    ln -sfn functions/ncm.usb0 configs/c.1/ncm.usb0
    ln -sfn functions/acm.gs0 configs/c.1/acm.gs0
    ln -sfn configs/c.1 os_desc/c.1
    echo "$controller" > UDC || { cd /; eend 1; return 1; }
    cd /
    eend 0
}

stop() {
    ebegin "Stopping Audio Module USB gadget"
    local g="/sys/kernel/config/usb_gadget/audio_module"
    if [ -e "$g/UDC" ]; then
        echo "" > "$g/UDC" 2>/dev/null || true
    fi
    eend 0
}
