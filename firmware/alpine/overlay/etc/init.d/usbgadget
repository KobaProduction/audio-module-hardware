#!/sbin/openrc-run
# Generic Linux USB NCM+ACM gadget. Identity supplied by conf.d.
description="Audio Module USB NCM/ACM gadget"

depend() {
    need sysfs
    before networking
}

start() {
    ebegin "Starting USB NCM and serial gadget"
    local controller g
    g="/sys/kernel/config/usb_gadget/audio_module"
    [ -d /sys/kernel/config/usb_gadget ] || { eend 1; return 1; }
    controller="$(ls /sys/class/udc 2>/dev/null | head -n 1)"
    [ -n "$controller" ] || { eend 1; return 1; }
    if [ -z "$gadget_manufacturer" ] || [ -z "$gadget_product" ] || [ -z "$gadget_serial" ] || [ -z "$gadget_dev_mac" ] || [ -z "$gadget_host_mac" ]; then
        eend 1 "Missing required device gadget identity"; return 1
    fi
    mkdir -p "$g"
    cd "$g" || { eend 1; return 1; }
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0200 > bcdUSB
    echo 0x0200 > bcdDevice
    echo 0xef > bDeviceClass
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol
    mkdir -p strings/0x409 configs/c.1/strings/0x409
    echo "$gadget_manufacturer" > strings/0x409/manufacturer
    echo "$gadget_product" > strings/0x409/product
    echo "$gadget_serial" > strings/0x409/serialnumber
    echo "NCM + ACM" > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower
    if [ ! -d functions/ncm.usb0 ]; then
        mkdir functions/ncm.usb0
        echo "$gadget_dev_mac" > functions/ncm.usb0/dev_addr
        echo "$gadget_host_mac" > functions/ncm.usb0/host_addr
    fi
    echo WINNCM > functions/ncm.usb0/os_desc/interface.ncm/compatible_id
    mkdir -p functions/acm.gs0
    echo 1 > os_desc/use
    echo 0xcd > os_desc/b_vendor_code
    echo MSFT100 > os_desc/qw_sign
    ln -sfn functions/ncm.usb0 configs/c.1/ncm.usb0
    ln -sfn functions/acm.gs0 configs/c.1/acm.gs0
    ln -sfn configs/c.1 os_desc/c.1
    echo "$controller" > UDC || { cd /; eend 1; return 1; }
    cd /
    eend 0
}

stop() {
    ebegin "Stopping USB gadget"
    local g="/sys/kernel/config/usb_gadget/audio_module"
    [ -e "$g/UDC" ] && echo "" > "$g/UDC" || true
    eend 0
}
